@using Duende.IdentityServer.Extensions
@using HowIdentity.Common.Constants
@{
#nullable enable
    string? name = null;
    if (!true.Equals(ViewData["signed-out"]))
    {
        name = Context.User?.GetDisplayName();
    }
}

<div class="nav-page">
    <nav class="navbar navbar-expand-lg navbar-dark how-navbar shadow-sm">
        <div class="container">
            <a href="~/" class="navbar-brand d-flex align-items-center font-weight-bold">
                <img src="~/duende-logo.svg" class="icon-banner mr-2" alt="Logo">
                <span>How Long Ago <small class="badge badge-primary ml-1">Identity</small></span>
            </a>

            <div class="d-flex align-items-center ml-auto">
                @if (Context.User!.IsInRole(IdentityRoleConstant.Role.SuperAdmin.Name))
                {
                    <a class="btn btn-sm btn-outline-light mr-2" asp-page="/SuperAdmin/AppUsers/Index">Manage Users</a>
                    <a class="btn btn-sm btn-outline-light mr-3" asp-page="/ServerSideSessions/Index">Sessions</a>
                }

                @if (!string.IsNullOrWhiteSpace(name))
                {
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle text-white font-weight-bold" data-toggle="dropdown">
                                @name <b class="caret"></b>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right">
                                <a class="dropdown-item" asp-page="/Account/Logout/Index">Sign Out</a>
                            </div>
                        </li>
                    </ul>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-sm btn-outline-light mr-2">Sign In</a>
                    <a href="/Account/Register" class="btn btn-sm btn-primary">Create Account</a>
                }
            </div>
        </div>
    </nav>
</div>